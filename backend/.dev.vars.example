TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=replace-me
TELEGRAM_BOT_TOKEN=replace-me
ADSGRAM_REWARD_SECRET=replace-with-a-long-random-secret

# Optional: local automatic-payout testing only. Never use a real production key here.
# Use an isolated test treasury with test funds; production credentials belong in Cloudflare Worker Secrets.
PAYOUT_ENABLED=false
# PAYOUT_PRIVATE_KEY=0x<64-hex-character-private-key>
# BSC_RPC_URL=https://your-bsc-mainnet-rpc.example
