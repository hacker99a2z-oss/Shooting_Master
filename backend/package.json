{
  "name": "shooting-master-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:migrate": "node scripts/apply-turso-schema.mjs",
    "db:import-supabase": "node scripts/import-supabase.mjs",
    "start": "npm run db:migrate && node scripts/apply-render-queue.mjs && node scripts/report-payout-state.mjs && node --experimental-strip-types api.mjs",
    "worker": "node --experimental-strip-types payout-worker.mjs",
    "dev": "wrangler dev --config worker/wrangler.toml",
    "deploy": "wrangler deploy --config worker/wrangler.toml",
    "db:migrate:render": "node scripts/apply-render-queue.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "wrangler": "^4.68.0"
  }
}
